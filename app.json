{
  "expo": {
    "name": "kulsah",
    "slug": "kulsah",
    "version": "1.0.0",
    "scheme": "kulsah",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.godfreddevsorganization.kulsah",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": true,
        "NSCameraUsageDescription": "Kulsah uses your camera when you host or co-host a Live.",
        "NSMicrophoneUsageDescription": "Kulsah uses your microphone when you host or co-host a Live.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.godfreddevsorganization.kulsah",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kulsah to use your camera when you host or co-host a Live.",
          "microphonePermission": "Allow Kulsah to use your microphone when you host or co-host a Live.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#38a9e5",
          "defaultChannel": "messages"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.66968860440-rh81s6n5gocqdfh8g7617i7h9cnllljl"
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "PlusJakartaSans",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/PlusJakartaSans-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "PlusJakartaSansMedium",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/PlusJakartaSans-Medium.ttf",
                    "weight": 500
                  }
                ]
              },
              {
                "fontFamily": "PlusJakartaSansBold",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/PlusJakartaSans-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "PlusJakartaSansExtraBold",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/PlusJakartaSans-ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": [
            "./assets/fonts/PlusJakartaSans-Regular.ttf",
            "./assets/fonts/PlusJakartaSans-Medium.ttf",
            "./assets/fonts/PlusJakartaSans-Bold.ttf",
            "./assets/fonts/PlusJakartaSans-ExtraBold.ttf",
            "./assets/fonts/GCGudlakDemo-Regular.ttf",
            "./assets/fonts/GCGudlakDemo-ExtraBold.ttf"
          ]
        }
      ],
      "expo-web-browser",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "96d7a304-4b49-4342-8407-fd445a974cc7"
      }
    },
    "owner": "godfred-kofis-team"
  }
}
