EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api/v1/

# Laravel Reverb uses the Pusher protocol. The app key is public client config;
# never expose REVERB_APP_SECRET in the mobile application.
# The local backend and Docker Compose default to this public app key. Leave
# host/port/scheme/auth empty to use the API origin and its Reverb proxy.
EXPO_PUBLIC_REVERB_APP_KEY=local
EXPO_PUBLIC_REVERB_HOST=
EXPO_PUBLIC_REVERB_PORT=
EXPO_PUBLIC_REVERB_SCHEME=
EXPO_PUBLIC_REVERB_AUTH_ENDPOINT=
# Optional when Reverb is reverse-proxied below a custom path.
EXPO_PUBLIC_REVERB_PATH=
